// Cloudflare Workers static-assets deploy. Without this file, `wrangler deploy`
// auto-configures the @astrojs/cloudflare adapter and turns the static site into SSR.
// The only Worker code is the /admin editor's GitHub login (worker/sveltia-cms-auth.js);
// GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET are dashboard secrets, not vars.
{
  "name": "abrar-website",
  "compatibility_date": "2026-10-01",
  "main": "./worker/sveltia-cms-auth.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/oauth/*"]
  },
  "vars": {
    // Only these sites may receive a token from the login popup.
    "ALLOWED_DOMAINS": "investforassets.com, www.investforassets.com"
  }
}
