---
import Icon from './Icon.astro';
import { url } from '../utils/url';

type Props = {
  title: string;
  intro?: string;
  linkHref?: string;
  linkLabel?: string;
  /** h2 by default; pass 'h1' when the section opens a page. */
  as?: 'h1' | 'h2';
  align?: 'start' | 'between';
  tone?: 'light' | 'dark';
  /** Two-digit section number. Renders the instrument-panel eyebrow above the title. */
  index?: string;
  /** Label beside the index. Defaults to the title, upper-cased by the stylesheet. */
  eyebrow?: string;
};

const {
  title,
  intro,
  linkHref,
  linkLabel = 'View all',
  as = 'h2',
  align = 'between',
  tone = 'light',
  index,
  eyebrow,
} = Astro.props as Props;
const Tag = as;
---

<div
  class:list={[
    'gap-4',
    align === 'between' ? 'flex flex-wrap items-end justify-between' : 'flex flex-col',
  ]}
>
  <div class="max-w-2xl">
    {
      index && (
        <p class="mono-label mb-2.5 flex items-center gap-2.5 text-beam-ink">
          <span>{index}</span>
          <span class="h-px w-6 bg-beam/50" aria-hidden="true" />
          <span class="text-ink-subtle">{eyebrow ?? title}</span>
        </p>
      )
    }
    <Tag
      class:list={[
        'text-display-3',
        tone === 'dark' ? 'text-ink' : '',
      ]}
    >
      {title}
    </Tag>
    {
      intro && (
        <p
          class:list={[
            'measure mt-2.5 text-[1.02rem] leading-relaxed',
            tone === 'dark' ? 'text-ink/85' : 'text-ink-muted',
          ]}
        >
          {intro}
        </p>
      )
    }
  </div>
  {
    linkHref && (
      <a
        href={url(linkHref)}
        class:list={['link-arrow shrink-0', tone === 'dark' ? 'text-beam-ink' : '']}
      >
        {linkLabel}
        <Icon name="arrow-right" size={16} />
      </a>
    )
  }
</div>
