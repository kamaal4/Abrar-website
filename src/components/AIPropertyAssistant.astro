---
import Icon from './Icon.astro';
import { getAllProperties } from '../data/properties';
import { getLocationName } from '../data/locations';
import { getImage } from '../data/images';
import { formatPrice, formatArea } from '../utils/format';
import { url } from '../utils/url';
import { getWhatsAppLink } from '../utils/whatsapp';
import type { AssistantProperty } from '../scripts/assistant-flow';

/**
 * Demo assistant. The conversation is scripted (see src/scripts/assistant-flow.ts) and
 * the matching runs against the same sample data the rest of the site uses. It is
 * labelled as a demo in the UI because pretending otherwise would be dishonest.
 */
const payload: AssistantProperty[] = getAllProperties().map((p) => {
  const img = getImage(p.images[0]!);
  return {
    slug: p.slug,
    title: p.title,
    location: p.location,
    locationName: getLocationName(p.location),
    type: p.type,
    bhk: p.bhk,
    price: p.price,
    priceLabel: formatPrice(p.price),
    area: `${formatArea(p.area)}`.replace('sq.ft', p.areaUnit === 'sqyd' ? 'sq.yd' : 'sq.ft'),
    image: img.src.src,
    alt: img.credit.alt,
    listing: [...p.listing],
    href: url(`/properties/${p.slug}`),
  };
});

const whatsappHref = getWhatsAppLink(
  "Hi, I used the assistant on your website and I'd like help shortlisting a property.",
);
---

<dialog
  id="assistant"
  class="m-0 mt-auto w-full max-w-none rounded-t-[1.5rem] bg-bg p-0 text-ink sm:m-auto sm:w-[min(34rem,92vw)] sm:rounded-panel"
  style="z-index: var(--z-modal)"
  aria-labelledby="assistant-title"
>
  <div class="flex max-h-[86vh] flex-col sm:max-h-[80vh]">
    <div class="flex items-start justify-between gap-3 border-b border-line px-5 py-4">
      <div>
        <h2 id="assistant-title" class="ui text-[1.05rem] font-bold tracking-[-0.02em]">
          Property Assistant
        </h2>
        <p class="mt-0.5 text-[0.78rem] text-ink-subtle">
          Demo assistant — scripted replies, not live AI.
        </p>
      </div>
      <button
        type="button"
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-line"
        data-assistant-close
        aria-label="Close assistant"
      >
        <Icon name="close" size={18} />
      </button>
    </div>

    <div
      id="assistant-log"
      class="flex-1 space-y-3 overflow-y-auto px-5 py-4"
      aria-live="polite"
      aria-atomic="false"
    >
    </div>

    <div class="border-t border-line px-5 py-4">
      <div id="assistant-options" class="flex flex-wrap gap-2"></div>
      <div class="mt-3 flex items-center justify-between gap-3">
        <button type="button" class="ui text-[0.82rem] font-semibold text-ink-subtle hover:text-ink" data-assistant-restart>
          Start over
        </button>
        <a href={whatsappHref} target="_blank" rel="noopener" class="btn btn-primary btn-sm">
          <Icon name="whatsapp" size={16} />
          Talk to a person
        </a>
      </div>
    </div>
  </div>
</dialog>

<script type="application/json" id="assistant-data" set:html={JSON.stringify(payload)} is:inline
></script>

<script>
  import {
    getStep,
    getNextStep,
    matchProperties,
    resultMessage,
    type Answers,
    type AssistantProperty,
    type Option,
  } from '../scripts/assistant-flow';

  const dialog = document.getElementById('assistant') as HTMLDialogElement | null;
  const log = document.getElementById('assistant-log');
  const optionsBar = document.getElementById('assistant-options');
  const dataEl = document.getElementById('assistant-data');
  if (dialog && log && optionsBar && dataEl) {
    const all: AssistantProperty[] = JSON.parse(dataEl.textContent || '[]');
    let answers: Answers = {};

    const bubble = (text: string, from: 'bot' | 'user') => {
      const row = document.createElement('div');
      row.className = from === 'bot' ? 'flex' : 'flex justify-end';
      const el = document.createElement('p');
      el.className =
        from === 'bot'
          ? 'max-w-[85%] rounded-2xl rounded-tl-md border border-line bg-surface px-3.5 py-2.5 text-[0.92rem] leading-relaxed'
          : 'max-w-[85%] rounded-2xl rounded-tr-md bg-ink px-3.5 py-2.5 text-[0.92rem] font-medium text-white';
      if (from === 'user') el.style.fontFamily = 'var(--font-display)';
      el.textContent = text;
      row.appendChild(el);
      log.appendChild(row);
      log.scrollTop = log.scrollHeight;
    };

    const results = (matches: AssistantProperty[]) => {
      const wrap = document.createElement('div');
      wrap.className = 'space-y-2';
      for (const p of matches) {
        const a = document.createElement('a');
        a.href = p.href;
        a.className =
          'flex gap-3 rounded-xl border border-line p-2.5 transition-colors hover:border-line-strong';
        a.innerHTML = `
          <img src="${p.image}" alt="${p.alt.replace(/"/g, '&quot;')}" width="88" height="66"
               loading="lazy" decoding="async"
               class="h-[66px] w-[88px] shrink-0 rounded-lg object-cover" />
          <span class="min-w-0">
            <span class="block truncate text-[0.92rem] font-semibold" style="font-family: var(--font-display)">${p.title}</span>
            <span class="mt-0.5 block text-[0.8rem] text-ink-muted">${p.locationName} · ${p.area}</span>
            <span class="mt-0.5 block text-[0.92rem] font-bold" style="font-family: var(--font-display)">${p.priceLabel}</span>
          </span>`;
        wrap.appendChild(a);
      }
      log.appendChild(wrap);
      log.scrollTop = log.scrollHeight;
    };

    const render = (stepId: string) => {
      const step = getStep(stepId);
      optionsBar.innerHTML = '';

      if (step.showResults) {
        const matches = matchProperties(all, answers);
        bubble(resultMessage(all, answers, matches), 'bot');
        if (matches.length) results(matches);
        else
          bubble(
            'Send us a message on WhatsApp and we will look for something that fits.',
            'bot',
          );
        return;
      }

      bubble(step.message, 'bot');

      for (const option of step.options ?? []) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className =
          'ui rounded-lg border border-line-strong px-3 py-1.5 text-[0.88rem] font-semibold transition-colors hover:border-ink hover:bg-surface';
        btn.textContent = option.label;
        btn.addEventListener('click', () => choose(step.key, option));
        optionsBar.appendChild(btn);
      }
    };

    const choose = (key: Answers extends never ? never : keyof Answers | undefined, option: Option) => {
      bubble(option.label, 'user');
      if (key) answers = { ...answers, [key]: option.value };
      optionsBar.innerHTML = '';
      // A short beat before the reply so the exchange reads as a conversation.
      window.setTimeout(() => render(getNextStep(option).id), 320);
    };

    const start = () => {
      answers = {};
      log.innerHTML = '';
      render('start');
    };

    document.querySelectorAll('[data-assistant-open]').forEach((el) =>
      el.addEventListener('click', () => {
        if (!log.childElementCount) start();
        dialog.showModal();
      }),
    );
    document
      .querySelectorAll('[data-assistant-close]')
      .forEach((el) => el.addEventListener('click', () => dialog.close()));
    document.querySelector('[data-assistant-restart]')?.addEventListener('click', start);
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
