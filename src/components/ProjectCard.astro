---
import Icon from './Icon.astro';
import Img from './Img.astro';
import { getLocationName } from '../data/locations';
import { formatPriceOrAsk } from '../utils/format';
import { statusLabels, type Project } from '../types';
import { url } from '../utils/url';

type Props = { project: Project };
const { project } = Astro.props;
const locationName = getLocationName(project.location);
const href = url(`/projects/${project.slug}`);
---

<article class="card group flex flex-col">
  <a href={href} class="card-media block aspect-[16/10]" tabindex="-1" aria-hidden="true">
    <Img
      image={project.images[0]!}
      widths={[400, 640, 900]}
      sizes="(min-width: 1024px) 28rem, (min-width: 640px) 45vw, 90vw"
      class="h-full w-full object-cover"
    />
  </a>

  <div class="flex flex-1 flex-col p-4">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-[1.1rem] font-bold leading-snug">
        <a href={href} class="hover:text-clay-ink">{project.name}</a>
      </h3>
      <span class="pill pill-quiet shrink-0">{statusLabels[project.status]}</span>
    </div>

    <p class="ui mt-1 flex items-center gap-1 text-[0.86rem] text-ink-muted">
      <Icon name="pin" size={14} />
      {locationName}, Hyderabad
    </p>

    <dl class="ui mt-3 grid grid-cols-2 gap-x-4 gap-y-2.5 border-t border-line pt-3 text-[0.84rem]">
      {/* With no published price this cell would read "Starting at — Price on
          request", which spends the most prominent slot on a non-answer. Show the
          colony instead, which is real information, until prices arrive. */}
      {
        project.startingPrice === undefined ? (
          <div>
            <dt class="text-ink-subtle">Locality</dt>
            <dd class="font-semibold text-ink">{project.locality ?? locationName}</dd>
          </div>
        ) : (
          <div>
            <dt class="text-ink-subtle">Starting at</dt>
            <dd class="font-bold text-clay-ink">{formatPriceOrAsk(project.startingPrice)}</dd>
          </div>
        )
      }
      <div>
        <dt class="text-ink-subtle">Configurations</dt>
        <dd class="font-semibold text-ink">{project.configurations.join(', ')}</dd>
      </div>
      <div>
        <dt class="text-ink-subtle">Possession</dt>
        <dd class="font-semibold text-ink">{project.possession}</dd>
      </div>
      <div>
        <dt class="text-ink-subtle">Scale</dt>
        <dd class="font-semibold text-ink">{project.units}</dd>
      </div>
    </dl>

    <div class="mt-auto pt-4">
      <a href={href} class="btn btn-outline btn-sm w-full">View Project</a>
    </div>
  </div>
</article>
