---
import Icon from './Icon.astro';
import { locationOptions } from '../data/locations';
import { budgetOptions } from '../data/properties';
import { propertyTypeLabels } from '../types';
import { url } from '../utils/url';

type Props = {
  /** 'hero' sits on a photograph; 'inline' sits on white. */
  variant?: 'hero' | 'inline';
  listing?: 'buy' | 'invest';
};

const { variant = 'hero', listing = 'buy' } = Astro.props;
const locations = locationOptions();
const types = Object.entries(propertyTypeLabels);
const onHero = variant === 'hero';
---

<form
  method="get"
  action={url('/properties')}
  class:list={[
    'rounded-panel border p-3 sm:p-4',
    onHero ? 'glass border-line shadow-panel' : 'border-line bg-surface',
  ]}
>
  <fieldset class="flex flex-wrap gap-1.5">
    <legend class="sr-only">Looking for</legend>
    {
      (['buy', 'invest'] as const).map((value) => (
        <label class="ui cursor-pointer">
          <input
            type="radio"
            name="listing"
            value={value}
            checked={value === listing}
            class="peer sr-only"
          />
          <span class="block rounded-lg border border-line-strong px-3.5 py-1.5 text-[0.86rem] font-semibold capitalize transition-colors peer-checked:border-beam peer-checked:bg-beam peer-checked:text-on-beam peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-beam-ink hover:bg-surface">
            {value}
          </span>
        </label>
      ))
    }
  </fieldset>

  <div class="mt-3 grid gap-2.5 sm:grid-cols-3 lg:grid-cols-[1fr_1fr_1fr_auto]">
    <div>
      <label class="field-label" for="search-type">Property type</label>
      <select id="search-type" name="type" class="field">
        <option value="">Any type</option>
        {types.map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>

    <div>
      <label class="field-label" for="search-location">Location</label>
      <select id="search-location" name="location" class="field">
        <option value="">All of Hyderabad</option>
        {locations.map((l) => <option value={l.value}>{l.label}</option>)}
      </select>
    </div>

    <div>
      <label class="field-label" for="search-budget">Budget</label>
      <select id="search-budget" name="budget" class="field">
        <option value="">Any budget</option>
        {budgetOptions.map((b) => <option value={b.value}>{b.label}</option>)}
      </select>
    </div>

    <div class="flex items-end">
      <button type="submit" class="btn btn-primary w-full lg:w-auto">
        <Icon name="search" size={17} />
        Search Properties
      </button>
    </div>
  </div>
</form>
