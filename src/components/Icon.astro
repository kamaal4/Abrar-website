---
/**
 * Inline icon set. Deliberately not a dependency: a dozen paths weigh less than a
 * package, and every glyph ships in the HTML with no extra request.
 * Line icons are drawn on a 24x24 grid with a 1.6 stroke; brand marks are filled
 * paths taken from the official Simple Icons set.
 */
export type IconName =
  | 'search'
  | 'whatsapp'
  | 'instagram'
  | 'facebook'
  | 'phone'
  | 'mail'
  | 'menu'
  | 'close'
  | 'chevron-down'
  | 'chevron-right'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'bed'
  | 'bath'
  | 'car'
  | 'area'
  | 'pin'
  | 'check'
  | 'heart'
  | 'filter'
  | 'spark'
  | 'calculator'
  | 'calendar'
  | 'building'
  | 'land'
  | 'layers'
  | 'clock'
  | 'send'
  | 'compass'
  | 'shield'
  | 'route';

type Props = {
  name: IconName;
  size?: number;
  class?: string;
  /** Icons are decorative by default; give a title only when the icon is the sole label. */
  title?: string;
};

const { name, size = 20, class: className, title } = Astro.props;

