---
import Icon from './Icon.astro';
import { footerNav, siteConfig } from '../config/site';
import { url } from '../utils/url';
import { getWhatsAppLink } from '../utils/whatsapp';

const year = new Date().getFullYear();
const socials = [
  { name: 'whatsapp' as const, label: 'WhatsApp', href: getWhatsAppLink('Hi, I found you online and would like to know more.') },
  { name: 'instagram' as const, label: 'Instagram', href: siteConfig.social.instagram },
  { name: 'facebook' as const, label: 'Facebook', href: siteConfig.social.facebook },
].filter((s) => Boolean(s.href));
---

<footer class="mt-px border-t border-line bg-surface">
  <div class="shell band-tight">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div>
        <p class="ui text-[1.15rem] font-bold leading-tight tracking-[-0.03em]">
          Invest In Real Estate<br /><span class="text-gold-ink">Hyderabad</span>
        </p>
        <p class="ui mt-2 text-[0.95rem] font-medium text-ink-muted">{siteConfig.tagline}</p>
        <p class="mt-4 max-w-xs text-[0.92rem] leading-relaxed text-ink-muted">
          Homes, plots, villas and investment property across Hyderabad — with straight answers about
          what each one is actually good for.
        </p>

        <ul class="mt-5 flex gap-2">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-line bg-bg text-ink transition-colors hover:border-ink hover:text-gold-ink"
                  aria-label={s.label}
                >
                  <Icon name={s.name} size={18} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        footerNav.map((group) => (
          <div>
            <h2 class="ui text-[0.82rem] font-bold text-ink">{group.heading}</h2>
            <ul class="mt-3 space-y-2">
              {group.items.map((item) => (
                <li>
                  <a
                    href={url(item.href)}
                    class="text-[0.92rem] text-ink-muted transition-colors hover:text-gold-ink"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-10 grid gap-4 border-t border-line pt-6 md:grid-cols-[1fr_auto] md:items-end">
      <div class="space-y-1 text-[0.88rem] text-ink-muted">
        {siteConfig.phone && (
          <p>
            <span class="ui font-semibold text-ink">Phone</span>{' '}
            <a href={`tel:${siteConfig.phone.replace(/[^\d+]/g, '')}`} class="hover:text-gold-ink"
              >{siteConfig.phone}</a
            >
          </p>
        )}
        {siteConfig.email && (
          <p>
            <span class="ui font-semibold text-ink">Email</span>{' '}
            <a href={`mailto:${siteConfig.email}`} class="hover:text-gold-ink">{siteConfig.email}</a>
          </p>
        )}
        <p>
          <span class="ui font-semibold text-ink">Based in</span> {siteConfig.city}, {siteConfig.state}
        </p>
      </div>
      <p class="text-[0.82rem] text-ink-subtle md:text-right">
        © {year} {siteConfig.name}. All rights reserved.
      </p>
    </div>

    <p class="mt-6 border-t border-line pt-5 text-[0.8rem] leading-relaxed text-ink-subtle">
      Properties, projects and prices shown on this website are illustrative sample content used
      while the listing catalogue is being built. Nothing here is an offer or a guarantee of
      availability, price or return. Verify all documents, approvals and figures independently before
      making any decision.
    </p>
  </div>
</footer>
