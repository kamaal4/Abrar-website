---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import PropertyFilters from '../../components/PropertyFilters.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { getAllProperties } from '../../data/properties';

const properties = getAllProperties();
---

<BaseLayout
  title="Properties in Hyderabad"
  description="Browse flats, commercial space, plots and land across Hyderabad — filter by location, budget, configuration and possession status."
>
  <section class="border-b border-line bg-surface">
    <div class="shell py-8 sm:py-10">
      <Breadcrumbs items={[{ label: 'Properties' }]} />
      <h1 class="mt-3 text-display-2">Properties in Hyderabad</h1>
      <p class="measure mt-3 text-[1.02rem] leading-relaxed text-ink-muted">
        Every unit configuration published across the developments we cover. Filter by what matters to you — everything
        updates as you go, and the URL keeps your selection so you can share it.
      </p>
    </div>
  </section>

  <div class="shell-wide py-8 lg:py-10">
    <div class="grid gap-8 lg:grid-cols-[17rem_1fr] lg:gap-10">
      <!-- Desktop filter rail. On mobile the same form is moved into the drawer below. -->
      <aside class="hidden lg:block">
        <div id="filter-home" class="sticky top-24">
          <h2 class="ui mb-4 flex items-center gap-2 text-[0.95rem] font-bold">
            <Icon name="filter" size={17} />
            Filters
          </h2>
          <PropertyFilters />
        </div>
      </aside>

      <div>
        <div class="mb-5 flex items-center justify-between gap-3">
          <p class="ui text-[0.92rem] font-semibold text-ink-muted" data-active-filters>
            {properties.length} listings
          </p>
          <button type="button" class="btn btn-outline btn-sm lg:hidden" data-filters-open>
            <Icon name="filter" size={16} />
            Filters
          </button>
        </div>

        <div id="property-grid" class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
          {properties.map((p, i) => <PropertyCard property={p} filterable eager={i < 3} />)}
        </div>

        <div
          id="property-empty"
          hidden
          class="rounded-panel border border-line bg-surface p-8 text-center"
        >
          <h2 class="text-[1.15rem]">Nothing matches those filters</h2>
          <p class="mx-auto mt-2 max-w-md text-[0.95rem] leading-relaxed text-ink-muted">
            If you set a budget, note that the developer publishes no prices — so every listing
            here shows "price on request", and a budget filter has nothing to match against. Clear
            it, or tell us your number and we will come back with what fits.
          </p>
          <div class="mt-5 flex flex-wrap justify-center gap-2.5">
            <WhatsAppButton
              label="Tell us what you need"
              message="Hi, I couldn't find what I was looking for on your website. I'm looking for…"
            />
            <button type="button" class="btn btn-outline" data-assistant-open>
              <Icon name="spark" size={17} />
              Ask the assistant
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <dialog
    id="filter-dialog"
    class="m-0 ml-auto h-full max-h-none w-[min(23rem,90vw)] max-w-none bg-bg p-0 text-ink"
    style="z-index: var(--z-drawer)"
    aria-label="Filter properties"
  >
    <div class="flex h-full flex-col">
      <div class="flex h-14 items-center justify-between border-b border-line px-5">
        <span class="ui font-bold">Filters</span>
        <button
          type="button"
          class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-line"
          data-filters-close
          aria-label="Close filters"
        >
          <Icon name="close" size={18} />
        </button>
      </div>
      <div id="filter-dialog-slot" class="flex-1 overflow-y-auto px-5 py-4"></div>
      <div class="border-t border-line px-5 py-3">
        <button type="button" class="btn btn-primary w-full" data-filters-close>
          Show results
        </button>
      </div>
    </div>
  </dialog>

  <script>
    import '../../scripts/property-filter';
  </script>
</BaseLayout>
