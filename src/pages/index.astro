---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import HeroImage from '../components/HeroImage.astro';
import SearchBar from '../components/SearchBar.astro';
import SectionHead from '../components/SectionHead.astro';
import PropertyCard from '../components/PropertyCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LocationCard from '../components/LocationCard.astro';
import CorridorRadar from '../components/CorridorRadar.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getFeaturedProperties, getAllProperties } from '../data/properties';
import { getFeaturedProjects, getAllProjects } from '../data/projects';
import { getFeaturedLocations, getAllLocations } from '../data/locations';
import { getCollection } from 'astro:content';
import { asImageKey } from '../data/images';
import { siteConfig } from '../config/site';
import { formatDate } from '../utils/format';
import { url } from '../utils/url';

const featured = getFeaturedProperties(6);
const projects = getFeaturedProjects(3);
const locations = getFeaturedLocations();
const allLocations = getAllLocations();
const propertyCount = getAllProperties().length;
const projectCount = getAllProjects().length;
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const categories = [
  {
    title: 'Buy a home',
    image: 'serene-heights-2' as const,
    copy: 'Apartments across Tolichowki, Alkapur, Shaikpet and the central belt — 2, 3 and 4 BHK in completed and under-construction buildings.',
    links: [
      { label: '2 BHK', href: '/properties?listing=buy&bhk=2' },
      { label: '3 BHK', href: '/properties?listing=buy&bhk=3' },
      { label: '4 BHK', href: '/properties?listing=buy&bhk=4' },
      { label: 'Ready to move', href: '/properties?status=ready-to-move' },
    ],
  },
  {
    title: 'Invest in land',
    image: 'future-city-1' as const,
    copy: 'Plotted layouts on the airport corridor and farm land west of the city — lower holding cost, longer horizon, heavier diligence.',
    links: [
      { label: 'Plots', href: '/properties?type=plot' },
      { label: 'Farm land', href: '/properties?type=farm-land' },
      { label: 'Flat vs plot', href: '/investment-insights#flat-vs-plot' },
      { label: 'Land areas', href: '/locations' },
    ],
  },
  {
    title: 'Commercial space',
    image: 'galaxy-1' as const,
    copy: 'Shops, offices and mixed-use floors in Alkapur, Shaikpet and Mehdipatnam — higher yield when tenanted, longer voids when not.',
    links: [
      { label: 'All commercial', href: '/properties?type=commercial' },
      { label: 'Under construction', href: '/properties?type=commercial&status=under-construction' },
      { label: 'Ready to move', href: '/properties?type=commercial&status=ready-to-move' },
      { label: 'Residential vs commercial', href: '/investment-insights#residential-vs-commercial' },
    ],
  },
];

/**
 * The case for property, condensed. Structure only — what a bank will lend
 * against, what you can do with it, what the tax code allows. No return claims;
 * the full argument lives on /investment-insights.
 */
const assetReasons = [
  {
    claim: 'A bank will fund most of it',
    copy: 'Home loans routinely run to 80% of the value. No lender advances 80% against gold or a share portfolio at anything close to that rate.',
  },
  {
    claim: 'You can live in it',
    copy: 'The only investment that also ends your rent. Gold in a locker does not house your family.',
  },
  {
    claim: 'Two ways to be paid',
    copy: 'Rent while you hold it, and whatever the sale brings later. Gold pays nothing until you sell.',
  },
  {
    claim: 'The tax code favours it',
    copy: 'Interest deductible under Section 24(b), principal under 80C, and its own treatment on long-term gains.',
  },
  {
    claim: 'You cannot panic-sell it',
    copy: 'Illiquidity reads as a drawback until a crash. Nobody cancels an EMI in a bad month; plenty of people cancel a SIP.',
  },
  {
    claim: 'You can actually inspect this one',
    copy: 'Walk the road at 9am, read the title, ask who floods. No diligence gives you that edge on a listed company.',
  },
];

/** Leverage, shown as what the money controls — never as what it returns. */
const leverageRows = [
  { label: '₹15 lakh into gold or an index fund', controls: '₹15 L', width: '20%', tone: 'quiet' as const },
  { label: '₹15 lakh down on a ₹75 lakh flat', controls: '₹75 L', width: '100%', tone: 'beam' as const },
];

/** The ticker under the hero: real counts and real localities, no invented metrics. */
const tickerItems = [
  `${allLocations.length} localities`,
  'Gachibowli',
  `${projectCount} live projects`,
  'Kokapet',
  'Financial District',
  `${propertyCount} listings`,
  'Tellapur',
  'Narsingi',
  'Kompally',
  'Shamshabad',
];

const steps = [
  { n: '01', title: 'Tell us your requirement', copy: 'Budget, area, purpose, configuration and how long you plan to hold.' },
  { n: '02', title: 'We find the matches', copy: 'The assistant shortlists from what we actually have, rather than everything on the market.' },
  { n: '03', title: 'Compare properties', copy: 'Side by side on the things that matter — possession, area, amenities and what is nearby.' },
  { n: '04', title: 'Site visit', copy: 'We arrange it, come along where it helps, and tell you what to look at while you are there.' },
  { n: '05', title: 'Due-diligence support', copy: 'Title, approvals, RERA position and the total acquisition cost — not just the quoted price.' },
  { n: '06', title: 'Make your decision', copy: 'With the awkward questions already asked, and no pressure from us either way.' },
];

const reasons = [
  {
    icon: 'spark' as const,
    title: 'AI-powered discovery',
    copy: 'Describe your goal in plain language — budget, area, purpose, horizon — and get a shortlist with the reasoning shown, instead of scrolling a thousand listings.',
  },
  {
    icon: 'pin' as const,
    title: 'Local Hyderabad expertise',
    copy: 'We work one city. That means we can tell you which stretch of road floods, where water supply is actually reliable, and which layout has approvals in place.',
  },
  {
    icon: 'layers' as const,
    title: 'Real comparison',
    copy: 'Possession status, unit counts, built-up area and what is within walking distance — laid out the same way for every project so you can compare like with like.',
  },
  {
    icon: 'shield' as const,
    title: 'Transparent information',
    copy: 'Where the developer publishes no price, we say "on request" rather than inventing one. Where an image is an artist\'s impression, we say that too.',
  },
  {
    icon: 'compass' as const,
    title: 'Guidance, not projections',
    copy: 'We will help you match a property to your budget and horizon. We will not hand you an appreciation forecast, because nobody can honestly make one.',
  },
  {
    icon: 'whatsapp' as const,
    title: 'WhatsApp support',
    copy: 'Every enquiry goes to a person on WhatsApp, not into a form queue. You get an answer from someone who knows the property.',
  },
];
---

<BaseLayout
  title={`${siteConfig.name} — Real estate investment in Hyderabad`}
  description={siteConfig.description}
>
  <!-- Hero: a real Hyderabad skyline carries the section; type sits over it. -->
  <section class="relative isolate overflow-hidden bg-surface-deep">
    <HeroImage
      wide="hyd-dusk-skyline-render"
      narrow="hyd-dusk-tower-render"
      alt="A financial-district skyline at dusk, towers lit above an elevated metro line"
      class="hero-settle absolute inset-0 -z-10 h-full w-full object-cover [filter:contrast(1.12)_saturate(1.08)]"
    />
    <!-- Two layers, not one: a vertical scrim so type is legible over any part of
         the photograph, and the ambient bloom over it so the fold belongs to the
         rest of the page rather than being a picture pasted on top. -->
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-b from-bg/85 via-bg/30 to-bg"
      aria-hidden="true"
    >
    </div>
    <div class="aurora absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>

    <div
      class="absolute inset-0 -z-10 hidden bg-[linear-gradient(100deg,var(--color-bg)_0%,color-mix(in_oklab,var(--color-bg)_82%,transparent)_38%,transparent_72%)] lg:block"
      aria-hidden="true"
    >
    </div>

    <div class="shell pb-10 pt-14 sm:pb-14 sm:pt-20 lg:pb-20 lg:pt-28">
      <p class="mono-label enter glow-text text-beam-ink">
        Hyderabad &middot; Residential, Commercial, Land
      </p>

      <!-- Telemetry line. The coordinates are Hyderabad's, and that is the whole
           claim — a real place, stated precisely. Nothing here is a metric. -->
      <ul class="mono-label enter d-1 mt-3 flex flex-wrap items-center gap-x-5 gap-y-1 text-ink-subtle">
        <li>17.3850&deg; N</li>
        <li>78.4867&deg; E</li>
        <li class="text-beam-ink">Hyderabad, Telangana</li>
      </ul>
      <h1 class="enter d-1 mt-3 max-w-3xl text-display-1 text-ink">
        Your Property.<br class="hidden sm:block" /> Your Asset. Your Future.
      </h1>
      <p class="enter d-2 measure mt-5 text-[1.08rem] leading-relaxed text-ink/85 sm:text-[1.18rem]">
        Residential, commercial and land across Hyderabad — with AI-powered discovery, real
        comparison, and straight answers about what each one is actually good for.
      </p>

      <ul class="ui enter d-2 mt-5 flex flex-wrap gap-x-3 gap-y-1 text-[0.82rem] font-semibold text-ink/90">
        {
          [
            'AI-powered discovery',
            'Smart investment',
            'Real comparison',
            'Hyderabad only',
          ].map((k, i) => (
            <li class="flex items-center gap-3">
              {i > 0 && <span class="text-ink/60" aria-hidden="true">·</span>}
              {k}
            </li>
          ))
        }
      </ul>

      <hr class="beam-rule enter-wipe d-3 mt-9 max-w-4xl border-0" aria-hidden="true" />

      <div class="enter d-3 mt-6 max-w-4xl">
        <SearchBar />
      </div>

      <div class="enter d-4 mt-6 flex flex-wrap items-center gap-2.5">
        <a href={url('/properties')} class="btn btn-on-dark">Explore properties</a>
        <a href={url('/invest')} class="btn btn-outline-on-dark">Find my investment</a>
        <button type="button" data-assistant-open class="btn btn-outline-on-dark">
          <Icon name="spark" size={17} />
          Talk to AI
        </button>
      </div>

      <!-- Instrument readouts. Every figure is counted from the same accessors
           the pages render from, so the strip cannot drift from the inventory. -->
      <dl class="enter d-4 mt-8 grid max-w-4xl gap-3 sm:grid-cols-3">
        {
          [
            {
              cat: 'Inventory',
              v: propertyCount,
              k: 'Listings',
              note: 'Published stock across residential, commercial and land.',
            },
            {
              cat: 'Coverage',
              v: projectCount,
              k: 'Projects tracked',
              note: 'Developer-published details, unit counts and areas.',
            },
            {
              cat: 'Ground',
              v: allLocations.length,
              k: 'Localities',
              note: 'Area guides written for orientation, not authority.',
            },
          ].map((r) => (
            <div class="readout hud-frame rounded-card px-5 py-4">
              <p class="mono-label text-beam-ink">{r.cat}</p>
              <dd class="readout-value mt-2">{String(r.v).padStart(2, '0')}</dd>
              <dt class="mono-label mt-1 text-ink">{r.k}</dt>
              <p class="mt-2 text-[0.82rem] leading-relaxed text-ink-subtle">{r.note}</p>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Ticker. Real counts from the same accessors the pages use, never invented
       metrics. The track holds two identical copies so the loop has no seam; the
       second is hidden from assistive tech, and the whole strip is decorative —
       every figure in it appears as text elsewhere on the page. -->
  <div class="ticker border-y border-line bg-surface-deep py-3">
    <div class="ticker-track">
      {
        [0, 1].map((copy) => (
          <ul class="mono-label flex shrink-0 items-center gap-8 pr-8" aria-hidden={copy === 1 ? 'true' : undefined}>
            {tickerItems.map((item) => (
              <li class="flex items-center gap-8 whitespace-nowrap">
                <span>{item}</span>
                <span class="text-beam-ink" aria-hidden="true">/</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <!-- The case for property. A ruled list beside a lead statement — an argument,
       not six identical icon tiles. -->
  <section class="techgrid band">
    <div class="shell">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div class="lg:sticky lg:top-28 lg:self-start">
          <p class="mono-label flex items-center gap-2.5 text-beam-ink">
            <span>02</span>
            <span class="h-px w-6 bg-beam/50" aria-hidden="true"></span>
            <span class="text-ink-subtle">Capital structure argument</span>
          </p>
          <h2 class="mt-2.5 text-display-2">Why property, when a mutual fund is one tap away?</h2>
          <p class="measure mt-4 text-[1.02rem] leading-relaxed text-ink-muted">
            Six things a flat can do that a demat account cannot. None of them is a claim about
            returns — they are facts about how the asset is built and what it lets you do.
          </p>
          <a href={url('/investment-insights#the-case')} class="link-arrow mt-6">
            The full case, and where gold and stocks win
            <Icon name="arrow-right" size={16} />
          </a>
        </div>

        <ul class="reveal-stagger">
          {
            assetReasons.map((r) => (
              <li class="border-t border-line py-5 first:border-t-0 first:pt-0">
                <h3 class="ui text-[1.08rem] font-bold leading-snug">{r.claim}</h3>
                <p class="mt-1.5 text-[0.96rem] leading-relaxed text-ink-muted">{r.copy}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Leverage. One idea, one fold, drawn rather than tabulated. -->
  <section class="band-tight border-y border-line bg-surface-deep">
    <div class="shell">
      <div class="hud-frame grid gap-8 py-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-16 lg:px-8">
        <div>
          <h2 class="text-display-3">The part no other asset can copy</h2>
          <p class="mt-3 text-[0.98rem] leading-relaxed text-ink-muted">
            Put ₹15 lakh into gold and you own ₹15 lakh of gold. Put the same ₹15 lakh down on a
            flat and a bank funds the rest.
          </p>
        </div>

        <div class="space-y-5">
          {
            leverageRows.map((row) => (
              <div>
                <div class="ui flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <span class="text-[0.93rem] font-semibold">{row.label}</span>
                  <span class="mono-data text-[1.15rem] font-bold text-ink">{row.controls}</span>
                </div>
                <!-- No overflow-hidden on the track: it would become the nearest scroll
                       container and leave `animation-timeline: view()` inert. The bar is
                       rounded on its own, so nothing needs clipping. -->
                  <div class="mt-2 h-3 w-full rounded-full bg-surface-deep">
                  <div
                    class={`bar-grow h-full rounded-full ${row.tone === 'beam' ? 'bg-beam shadow-[0_0_18px_var(--color-beam)]' : 'bg-ink-subtle'}`}
                    style={`--w: ${row.width}; width: ${row.width}`}
                  />
                </div>
              </div>
            ))
          }

          <p class="text-[0.86rem] leading-relaxed text-ink-subtle">
            What your money <em>controls</em>, not what it earns. Leverage works in both directions
            and the EMI arrives either way — an advantage only if the loan is one you can service
            through a bad year. Educational, not financial advice.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- AI assistant pitch. The differentiator, so it gets its own fold. -->
  <section class="band border-t border-line">
    <div class="shell">
      <div class="grid gap-8 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-14">
        <div>
          <p class="mono-label flex items-center gap-2.5 text-beam-ink">
            <span>03</span>
            <span class="h-px w-6 bg-beam/50" aria-hidden="true"></span>
            <span class="text-ink-subtle">Asset matching engine</span>
          </p>
          <h2 class="mt-2.5 text-display-2">Tell the assistant what you want to achieve</h2>
          <p class="measure mt-4 text-[1.02rem] leading-relaxed text-ink-muted">
            Not a keyword search. Describe the outcome you are after and it shortlists from what we
            actually have — comparing budget, location, configuration, possession status,
            connectivity and what is within walking distance.
          </p>
          <div class="mt-6 flex flex-wrap gap-2.5">
            <button type="button" data-assistant-open class="btn btn-primary">
              <Icon name="spark" size={17} />
              Ask the assistant
            </button>
            <a href={url('/investment-insights')} class="btn btn-outline">
              Investment insights
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>

        <div class="rounded-panel border border-line bg-surface shadow-lift">
          <!-- Terminal chrome: the panel reads as a readout rather than a card. -->
          <div class="mono-label flex items-center gap-2.5 border-b border-line px-5 py-2.5 text-ink-subtle">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-beam" aria-hidden="true"></span>
            <span class="text-beam-ink">Assistant</span>
            <span aria-hidden="true">//</span>
            <span>Example brief</span>
          </div>
          <div class="p-5 sm:p-6">
          <p class="sr-only">For example</p>
          <dl class="ui mt-3 divide-y divide-line text-[0.95rem]">
            {
              [
                { k: 'Budget', v: '₹75 lakh' },
                { k: 'Location', v: 'Tolichowki' },
                { k: 'Purpose', v: 'Investment' },
                { k: 'Property', v: '2 or 3 BHK' },
                { k: 'Holding period', v: '5–10 years' },
              ].map((row) => (
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-ink-muted">{row.k}</dt>
                  <dd class="font-bold">{row.v}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-4 border-t border-line pt-4 text-[0.88rem] leading-relaxed text-ink-subtle">
            The assistant matches on the facts the developer publishes. Where no price is published
            it says so instead of guessing — and a budget filter excludes those rather than
            pretending they fit.
          </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="band bg-surface-deep">
    <div class="shell">
      <SectionHead
        index="04"
        eyebrow="Quantitative workflow"
        title="Mechanical rigour, from title diligence to transfer."
        intro="Six steps, and you can stop at any of them."
        align="start"
      />
      <ol class="reveal-stagger mt-8 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          steps.map((st) => (
            <li class="hud-step mr-4 pb-7">
              <p class="mono-data text-beam-ink">{st.n}</p>
              <h3 class="mt-1.5 text-[1.05rem]">{st.title}</h3>
              <p class="mt-2 text-[0.94rem] leading-relaxed text-ink-muted">{st.copy}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Three ways in. Photographs, not icon tiles. -->
  <section class="band">
    <div class="shell">
      <div class="reveal-stagger grid gap-8 md:grid-cols-3 md:gap-6">
        {
          categories.map((c) => (
            <div class="flex flex-col">
              <div class="card-media aspect-[3/2] overflow-hidden rounded-card">
                <Img
                  image={c.image}
                  widths={[400, 640, 800]}
                  sizes="(min-width: 768px) 22rem, 92vw"
                  class="h-full w-full object-cover"
                />
              </div>
              <h2 class="mt-4 text-[1.3rem]">{c.title}</h2>
              <p class="mt-2 text-[0.96rem] leading-relaxed text-ink-muted">{c.copy}</p>
              <ul class="ui mt-3.5 flex flex-wrap gap-1.5">
                {c.links.map((l) => (
                  <li>
                    <a
                      href={url(l.href)}
                      class="inline-block rounded-lg border border-line px-2.5 py-1 text-[0.85rem] font-semibold transition-colors hover:border-beam hover:bg-surface"
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured properties -->
  <section class="band bg-surface-deep">
    <div class="shell">
      <SectionHead
        index="05"
        eyebrow="Verified inventory"
        title="Curated Hyderabad asset deployments"
        intro="A cross-section of what is available right now — apartments, commercial floors and land, across the corridors we cover."
        linkHref="/properties"
        linkLabel="All properties"
      />
      <div class="reveal-stagger mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((p, i) => <PropertyCard property={p} eager={i < 3} />)}
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="band">
    <div class="shell">
      <SectionHead
        index="06"
        eyebrow="Developer projects"
        title="Projects worth knowing about"
        intro="Developments across Hyderabad, grouped so you can see possession status before anything else."
        linkHref="/projects"
        linkLabel="All projects"
      />
      <div class="reveal-stagger mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- Locations: one large tile, then smaller ones. Not an equal grid. -->
  <section class="band border-t border-line">
    <div class="shell">
      <SectionHead
        index="07"
        eyebrow="Spatial radar"
        title="Hyderabad high-velocity growth corridors"
        intro="Every corridor in this city solves a different problem. Here is what each one is genuinely good at."
        linkHref="/locations"
        linkLabel="All locations"
      />
      <div class="mt-8">
        <CorridorRadar />
      </div>

      <div class="mt-4 grid gap-4 lg:grid-cols-[1.35fr_1fr]">
        <LocationCard location={locations[0]!} feature />
        <div class="grid gap-4 sm:grid-cols-2">
          {locations.slice(1, 5).map((l) => <LocationCard location={l} />)}
        </div>
      </div>

      <ul class="ui mt-5 flex flex-wrap gap-1.5">
        {
          allLocations.map((l) => (
            <li>
              <a
                href={url(`/locations/${l.slug}`)}
                class="inline-block rounded-lg border border-line px-2.5 py-1 text-[0.85rem] font-medium text-ink-muted transition-colors hover:border-beam hover:text-ink"
              >
                {l.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- The one drenched fold on the site. -->
  <!-- The lit fold. On a light page this was a drenched block of accent; on black
       a full azure fold at this size is unbearable, so the accent arrives as light
       behind the fold instead of as paint on it. -->
  <section class="techgrid relative isolate overflow-hidden border-y border-line bg-bg text-ink">
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(48rem_28rem_at_78%_50%,var(--color-beam-wash),transparent_70%)]"
      aria-hidden="true"
    >
    </div>
    <div class="shell band">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-16">
        <div>
          <h2 class="text-display-2 text-ink">Invest in Hyderabad with your eyes open</h2>
          <p class="mt-5 max-w-xl text-[1.05rem] leading-relaxed text-ink/90">
            Infrastructure that got built rather than only announced, and an employment base spread
            across several corridors. That is a reasonable foundation — but every property still has
            to be underwritten on its own facts, and we will do that with you rather than hand you a
            projection.
          </p>

          <div class="mt-7 flex flex-wrap gap-2.5">
            <WhatsAppButton
              variant="on-dark"
              label="Talk to a property consultant"
              message="Hi, I'd like to talk to a consultant about investing in Hyderabad property."
            />
            <a href={url('/investment-insights')} class="btn btn-outline-on-dark">
              Investment insights
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>

        <ul class="grid gap-px overflow-hidden rounded-panel bg-line-strong sm:grid-cols-2">
          {
            [
              { k: 'Residential', v: 'Apartments in areas with real rental demand' },
              { k: 'Commercial', v: 'Shops, offices and mixed-use floors' },
              { k: 'Plots and land', v: 'Long-horizon parcels, diligence-heavy' },
              { k: 'Under construction', v: 'Possession-timeline arbitrage' },
            ].map((item) => (
              <li class="bg-surface p-5">
                <p class="mono-label">{item.k}</p>
                <p class="mt-2 text-[0.95rem] leading-relaxed text-ink">{item.v}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Why us: a ruled list with hierarchy, not six identical tiles. -->
  <section class="band">
    <div class="shell">
      <SectionHead
        index="08"
        eyebrow="Method"
        title="Why choose us"
        intro="No claims we cannot stand behind. Here is what we actually do."
        align="start"
      />
      <ul class="reveal-stagger mt-8 grid gap-x-12 gap-y-0 md:grid-cols-2">
        {
          reasons.map((r) => (
            <li class="border-t border-line py-5">
              <h3 class="ui flex items-center gap-2.5 text-[1.05rem] font-bold">
                <Icon name={r.icon} size={19} class="shrink-0 text-beam-ink" />
                {r.title}
              </h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-muted">{r.copy}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Blog -->
  <section class="band border-t border-line bg-surface-deep">
    <div class="shell">
      <SectionHead
        index="09"
        eyebrow="Reading"
        title="Learn before you invest"
        intro="The questions people actually ask us, answered at length."
        linkHref="/blog"
        linkLabel="All articles"
      />
      <div class="reveal-stagger mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => (
            <a href={url(`/blog/${post.id}`)} class="card group flex flex-col">
              <span class="card-media block aspect-[16/9]">
                <Img
                  image={asImageKey(post.data.heroImage)}
                  widths={[400, 640, 800]}
                  sizes="(min-width: 1024px) 24rem, 92vw"
                  class="h-full w-full object-cover"
                />
              </span>
              <span class="flex flex-1 flex-col p-4">
                <span class="ui text-[0.78rem] font-semibold text-beam-ink">{post.data.category}</span>
                <span class="mt-1.5 text-[1.02rem] font-bold leading-snug group-hover:text-beam-ink" style="font-family: var(--font-display)">
                  {post.data.title}
                </span>
                <span class="mt-2 flex-1 text-[0.92rem] leading-relaxed text-ink-muted">
                  {post.data.description}
                </span>
                <span class="ui mt-3 text-[0.8rem] text-ink-subtle">
                  {formatDate(post.data.date)} · {post.data.readingTime} min read
                </span>
              </span>
            </a>
          ))
        }
      </div>
      <a href={url('/investment-insights')} class="link-arrow mt-8">
        Property vs gold, stocks, a business and an FD — the full comparison
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </section>

  <!-- Closing CTA. The page opened on an ambient bloom and closes on one. -->
  <section class="relative isolate overflow-hidden border-t border-line bg-surface-deep">
    <div class="aurora absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="shell band text-center">
      <h2 class="text-display-2 text-ink">Don’t just buy a property. Understand the asset.</h2>
      <p class="measure mx-auto mt-4 text-[1.05rem] leading-relaxed text-ink/85">
        Explore what is available, compare the opportunities against your own horizon, and make a
        more informed real-estate decision.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href={url('/properties')} class="btn btn-on-dark">Explore properties</a>
        <button type="button" data-assistant-open class="btn btn-outline-on-dark">
          <Icon name="spark" size={17} />
          Ask AI
        </button>
        <WhatsAppButton
          message="Hi, I'd like help finding the right property in Hyderabad."
          label="WhatsApp us"
          variant="outline-on-dark"
        />
      </div>
    </div>
  </section>
</BaseLayout>
