---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import HeroImage from '../components/HeroImage.astro';
import SearchBar from '../components/SearchBar.astro';
import SectionHead from '../components/SectionHead.astro';
import PropertyCard from '../components/PropertyCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LocationCard from '../components/LocationCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getFeaturedProperties } from '../data/properties';
import { getFeaturedProjects } from '../data/projects';
import { getFeaturedLocations, getAllLocations } from '../data/locations';
import { getCollection } from 'astro:content';
import { asImageKey } from '../data/images';
import { siteConfig } from '../config/site';
import { formatDate } from '../utils/format';
import { url } from '../utils/url';

const featured = getFeaturedProperties(6);
const projects = getFeaturedProjects(3);
const locations = getFeaturedLocations();
const allLocations = getAllLocations();
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const categories = [
  {
    title: 'Buy a home',
    image: 'aparna-zenon-towers' as const,
    copy: 'Apartments and villas across the city, from a first 2 BHK to a four-bedroom in a gated layout.',
    links: [
      { label: '2 BHK', href: '/properties?listing=buy&bhk=2' },
      { label: '3 BHK', href: '/properties?listing=buy&bhk=3' },
      { label: '4 BHK', href: '/properties?listing=buy&bhk=4' },
      { label: 'Villas', href: '/properties?listing=buy&type=villa' },
    ],
  },
  {
    title: 'Invest in land',
    image: 'telangana-farmland-2' as const,
    copy: 'Plots, open land and farm land on the western corridor — lower holding cost, longer horizon.',
    links: [
      { label: 'Plots', href: '/properties?type=plot' },
      { label: 'Open land', href: '/properties?type=open-land' },
      { label: 'Farm land', href: '/properties?type=farm-land' },
      { label: 'How to evaluate land', href: '/blog/plot-vs-apartment-which-is-better-for-investment' },
    ],
  },
  {
    title: 'Explore projects',
    image: 'tellapur-towers' as const,
    copy: 'New launches, towers under construction and completed developments you can walk through today.',
    links: [
      { label: 'New launches', href: '/projects?status=new-launch' },
      { label: 'Under construction', href: '/projects?status=under-construction' },
      { label: 'Ready to move', href: '/projects?status=ready-to-move' },
      { label: 'All projects', href: '/projects' },
    ],
  },
];

const reasons = [
  {
    icon: 'shield' as const,
    title: 'Verified property information',
    copy: 'Where a listing is marked verified, it means we have seen the documents and the property ourselves. Where we have not, we say so on the listing rather than leaving you to assume.',
  },
  {
    icon: 'pin' as const,
    title: 'Local Hyderabad expertise',
    copy: 'We work one city. That means we can tell you which stretch of a road floods, where water supply is actually reliable, and which layout has approvals in place.',
  },
  {
    icon: 'compass' as const,
    title: 'Investment guidance, not projections',
    copy: 'We will help you match a property to your budget and horizon. We will not hand you an appreciation forecast, because nobody can honestly make one.',
  },
  {
    icon: 'route' as const,
    title: 'Site visit support',
    copy: 'We arrange visits, come along where it helps, and tell you what to look at while you are there — including the things a brochure will not mention.',
  },
  {
    icon: 'layers' as const,
    title: 'Transparent information',
    copy: 'Carpet area alongside super built-up. Total cost including registration and stamp duty, not just the quoted price.',
  },
  {
    icon: 'whatsapp' as const,
    title: 'Talk to a person',
    copy: 'Every enquiry on this site goes to a consultant on WhatsApp, not into a form queue. You get an answer from someone who knows the property.',
  },
];
---

<BaseLayout
  title={`${siteConfig.name} — Find. Invest. Grow.`}
  description={siteConfig.description}
>
  <!-- Hero: a real Hyderabad skyline carries the section; type sits over it. -->
  <section class="relative isolate overflow-hidden bg-ink">
    <HeroImage
      wide="hyd-financial-district-panorama"
      narrow="gachibowli-skyview"
      alt="Towers of the Hyderabad Financial District at dusk"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-[0.82] sm:opacity-[0.78]"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/78 via-ink/50 to-ink/82"
      aria-hidden="true"
    >
    </div>

    <div class="shell pb-10 pt-14 sm:pb-14 sm:pt-20 lg:pb-20 lg:pt-28">
      <p class="ui enter text-[0.92rem] font-semibold text-gold">{siteConfig.tagline}</p>
      <h1 class="enter d-1 mt-3 max-w-3xl text-display-1 text-white">
        Find the right property in Hyderabad
      </h1>
      <p class="enter d-2 measure mt-5 text-[1.08rem] leading-relaxed text-white/85 sm:text-[1.18rem]">
        Explore verified homes, plots, villas and investment opportunities across the city — with
        straight answers about what each one is actually good for.
      </p>

      <div class="enter d-3 mt-8 max-w-4xl">
        <SearchBar />
      </div>

      <p class="enter d-4 mt-5 text-[0.95rem] text-white/80">
        Not sure what to choose?{' '}
        <button
          type="button"
          data-assistant-open
          class="ui font-semibold text-gold underline decoration-gold/50 decoration-2 underline-offset-4 transition-colors hover:text-white hover:decoration-white"
        >
          Ask our AI Property Assistant →
        </button>
      </p>
    </div>
  </section>

  <!-- Three ways in. Photographs, not icon tiles. -->
  <section class="band">
    <div class="shell">
      <div class="grid gap-8 md:grid-cols-3 md:gap-6">
        {
          categories.map((c) => (
            <div class="flex flex-col">
              <div class="card-media aspect-[3/2] overflow-hidden rounded-card">
                <Img
                  image={c.image}
                  widths={[400, 640, 800]}
                  sizes="(min-width: 768px) 22rem, 92vw"
                  class="h-full w-full object-cover"
                />
              </div>
              <h2 class="mt-4 text-[1.3rem]">{c.title}</h2>
              <p class="mt-2 text-[0.96rem] leading-relaxed text-ink-muted">{c.copy}</p>
              <ul class="ui mt-3.5 flex flex-wrap gap-1.5">
                {c.links.map((l) => (
                  <li>
                    <a
                      href={url(l.href)}
                      class="inline-block rounded-lg border border-line px-2.5 py-1 text-[0.85rem] font-semibold transition-colors hover:border-ink hover:bg-surface"
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured properties -->
  <section class="band border-t border-line bg-surface">
    <div class="shell">
      <SectionHead
        title="Featured properties"
        intro="A cross-section of what we are working on right now — apartments, villas and land, in different parts of the city."
        linkHref="/properties"
        linkLabel="All properties"
      />
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((p, i) => <PropertyCard property={p} eager={i < 3} />)}
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="band">
    <div class="shell">
      <SectionHead
        title="Projects worth knowing about"
        intro="Sample developments across the corridors buyers ask about most — with possession status stated up front."
        linkHref="/projects"
        linkLabel="All projects"
      />
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- Locations: one large tile, then smaller ones. Not an equal grid. -->
  <section class="band border-t border-line">
    <div class="shell">
      <SectionHead
        title="Explore Hyderabad by location"
        intro="Every corridor in this city solves a different problem. Here is what each one is genuinely good at."
        linkHref="/locations"
        linkLabel="All locations"
      />
      <div class="mt-8 grid gap-4 lg:grid-cols-[1.35fr_1fr]">
        <LocationCard location={locations[0]!} feature />
        <div class="grid gap-4 sm:grid-cols-2">
          {locations.slice(1, 5).map((l) => <LocationCard location={l} />)}
        </div>
      </div>

      <ul class="ui mt-5 flex flex-wrap gap-1.5">
        {
          allLocations.map((l) => (
            <li>
              <a
                href={url(`/locations/${l.slug}`)}
                class="inline-block rounded-lg border border-line px-2.5 py-1 text-[0.85rem] font-medium text-ink-muted transition-colors hover:border-ink hover:text-ink"
              >
                {l.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- The one drenched fold on the site. -->
  <section class="bg-gold-deep text-white">
    <div class="shell band">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-16">
        <div>
          <h2 class="text-display-2 text-white">Invest in Hyderabad with your eyes open</h2>
          <p class="mt-5 max-w-xl text-[1.05rem] leading-relaxed text-white/90">
            Infrastructure that got built rather than only announced, an employment base spread
            across several corridors, and price points from ₹30 lakh plots to ₹5 crore towers. That
            is a reasonable foundation — but every property still has to be underwritten on its own
            facts, and we will do that with you rather than hand you a projection.
          </p>

          <div class="mt-7 flex flex-wrap gap-2.5">
            <WhatsAppButton
              variant="on-dark"
              label="Talk to a property consultant"
              message="Hi, I'd like to talk to a consultant about investing in Hyderabad property."
            />
            <a href={url('/invest')} class="btn btn-outline-on-dark">
              How we approach investment
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>

        <ul class="grid gap-px overflow-hidden rounded-panel bg-white/25 sm:grid-cols-2">
          {
            [
              { k: 'Residential', v: 'Apartments and villas with real rental demand' },
              { k: 'Plots', v: 'Approved layouts on the western corridor' },
              { k: 'Open land', v: 'Long-horizon parcels, diligence-heavy' },
              { k: 'Under construction', v: 'Possession-timeline arbitrage' },
            ].map((item) => (
              <li class="bg-gold-deep p-5">
                <p class="ui text-[0.95rem] font-bold text-white">{item.k}</p>
                <p class="mt-1 text-[0.9rem] leading-relaxed text-white/85">{item.v}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Why us: a ruled list with hierarchy, not six identical tiles. -->
  <section class="band">
    <div class="shell">
      <SectionHead
        title="Why work with us"
        intro="No claims we cannot stand behind. Here is what we actually do."
        align="start"
      />
      <ul class="mt-8 grid gap-x-12 gap-y-0 md:grid-cols-2">
        {
          reasons.map((r) => (
            <li class="border-t border-line py-5">
              <h3 class="ui flex items-center gap-2.5 text-[1.05rem] font-bold">
                <Icon name={r.icon} size={19} class="shrink-0 text-gold-ink" />
                {r.title}
              </h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-muted">{r.copy}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Blog -->
  <section class="band border-t border-line bg-surface">
    <div class="shell">
      <SectionHead
        title="Reading before you buy"
        intro="The questions people actually ask us, answered at length."
        linkHref="/blog"
        linkLabel="All articles"
      />
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => (
            <a href={url(`/blog/${post.id}`)} class="card group flex flex-col">
              <span class="card-media block aspect-[16/9]">
                <Img
                  image={asImageKey(post.data.heroImage)}
                  widths={[400, 640, 800]}
                  sizes="(min-width: 1024px) 24rem, 92vw"
                  class="h-full w-full object-cover"
                />
              </span>
              <span class="flex flex-1 flex-col p-4">
                <span class="ui text-[0.78rem] font-semibold text-gold-ink">{post.data.category}</span>
                <span class="mt-1.5 text-[1.02rem] font-bold leading-snug group-hover:text-gold-ink" style="font-family: var(--font-display)">
                  {post.data.title}
                </span>
                <span class="mt-2 flex-1 text-[0.92rem] leading-relaxed text-ink-muted">
                  {post.data.description}
                </span>
                <span class="ui mt-3 text-[0.8rem] text-ink-subtle">
                  {formatDate(post.data.date)} · {post.data.readingTime} min read
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
