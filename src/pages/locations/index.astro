---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LocationCard from '../../components/LocationCard.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { getAllLocations } from '../../data/locations';
import { formatPriceOrAsk } from '../../utils/format';
import { propertyTypeLabels } from '../../types';
import { url } from '../../utils/url';

const locations = getAllLocations();
const zones = (['West', 'North', 'East', 'Central', 'South'] as const)
  .map((zone) => ({ zone, items: locations.filter((l) => l.zone === zone) }))
  .filter((z) => z.items.length > 0);
const featured = locations.filter((l) => l.featured);
---

<BaseLayout
  title="Hyderabad locations"
  description="Explore Hyderabad by location — what each corridor is good at, indicative price ranges, popular property types and connectivity."
>
  <section class="border-b border-line bg-surface">
    <div class="shell py-8 sm:py-10">
      <Breadcrumbs items={[{ label: 'Locations' }]} />
      <h1 class="mt-3 text-display-2">Hyderabad, corridor by corridor</h1>
      <p class="measure mt-3 text-[1.02rem] leading-relaxed text-ink-muted">
        Every part of this city solves a different problem — commute, budget, built-up area, or a long
        hold. Here is what each one is genuinely good at, and what you give up in exchange.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="shell">
      <div class="grid gap-4 lg:grid-cols-[1.35fr_1fr]">
        <LocationCard location={featured[0]!} feature />
        <div class="grid gap-4 sm:grid-cols-2">
          {featured.slice(1, 5).map((l) => <LocationCard location={l} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="band-tight border-t border-line">
    <div class="shell">
      <h2 class="text-display-3">Every location we cover</h2>
      <p class="mt-2 text-[0.85rem] text-ink-subtle">
        Price guidance and travel times are indicative, for orientation only. Areas we have not
        priced ourselves show no figure rather than a guess.
      </p>

      {
        zones.map((z) => (
          <div class="mt-8">
            <h3 class="ui text-[0.95rem] font-bold text-ink-muted">{z.zone} Hyderabad</h3>
            <div class="scroll-x mt-3 rounded-panel border border-line">
              <table class="w-full min-w-[38rem] text-left text-[0.94rem]">
                <thead class="ui border-b border-line bg-surface text-[0.8rem] text-ink-muted">
                  <tr>
                    <th scope="col" class="p-3.5 font-semibold">Location</th>
                    <th scope="col" class="p-3.5 font-semibold">Best known for</th>
                    <th scope="col" class="p-3.5 font-semibold">Popular types</th>
                    <th scope="col" class="p-3.5 text-right font-semibold">From</th>
                  </tr>
                </thead>
                <tbody>
                  {z.items.map((l) => (
                    <tr class="border-b border-line last:border-0">
                      <th scope="row" class="p-3.5">
                        <a
                          href={url(`/locations/${l.slug}`)}
                          class="ui font-bold hover:text-beam-ink"
                        >
                          {l.name}
                        </a>
                      </th>
                      <td class="p-3.5 text-ink-muted">{l.tagline}</td>
                      <td class="ui p-3.5 text-[0.86rem] text-ink-muted">
                        {l.popularTypes.map((t) => propertyTypeLabels[t]).join(', ')}
                      </td>
                      <td class="ui p-3.5 text-right font-bold">{formatPriceOrAsk(l.startingPrice)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }

      <div class="mt-12 rounded-panel border border-line bg-surface p-6 sm:p-8">
        <h2 class="text-[1.3rem]">Looking somewhere we have not covered?</h2>
        <p class="measure mt-2.5 text-[0.98rem] leading-relaxed text-ink-muted">
          We work across Hyderabad, not only the areas listed here. Tell us where you are looking and
          what for, and we will tell you what the area is actually like.
        </p>
        <div class="mt-5">
          <WhatsAppButton
            label="Ask about an area"
            message="Hi, I'm looking at a specific area in Hyderabad and would like to know more:"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
