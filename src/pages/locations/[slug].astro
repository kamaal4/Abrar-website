---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import Img from '../../components/Img.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import SectionHead from '../../components/SectionHead.astro';
import Faq from '../../components/Faq.astro';
import { getAllLocations, getLocationBySlug } from '../../data/locations';
import { getPropertiesByLocation } from '../../data/properties';
import { getProjectsByLocation } from '../../data/projects';
import { formatPriceLong } from '../../utils/format';
import { propertyTypeLabels } from '../../types';
import { url } from '../../utils/url';

export const getStaticPaths: GetStaticPaths = () =>
  getAllLocations().map((l) => ({ params: { slug: l.slug } }));

const { slug } = Astro.params;
const location = getLocationBySlug(slug!);
if (!location) throw new Error(`No location for slug "${slug}"`);

const listings = getPropertiesByLocation(location.slug);
const projects = getProjectsByLocation(location.slug);
const others = getAllLocations().filter((l) => l.slug !== location.slug && l.zone === location.zone);

const faqLd =
  location.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: location.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : undefined;
---

<BaseLayout
  title={`Properties in ${location.name}, Hyderabad`}
  description={`${location.tagline}. Price guidance, popular configurations, connectivity and available listings in ${location.name}, Hyderabad.`}
  jsonLd={faqLd}
>
  <section class="relative isolate overflow-hidden bg-surface-deep">
    <Img
      image={location.image}
      widths={[900, 1280, 1440]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-70"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-bg/90 via-bg/50 to-bg/60" aria-hidden="true"></div>

    <div class="shell py-8 sm:py-12 lg:py-16">
      <Breadcrumbs
        tone="dark"
        items={[{ label: 'Locations', href: '/locations' }, { label: location.name }]}
      />
      <h1 class="mt-4 text-display-2 text-ink">
        Properties in {location.name}, Hyderabad
      </h1>
      <p class="measure mt-3 text-[1.08rem] leading-relaxed text-ink/85">{location.tagline}</p>

      <dl class="ui mt-7 flex flex-wrap gap-x-8 gap-y-3 text-ink">
        <div>
          <dt class="text-[0.8rem] text-ink/70">Listings</dt>
          <dd class="text-[1.2rem] font-bold">{listings.length}</dd>
        </div>
        {
          location.startingPrice !== undefined && (
            <div>
              <dt class="text-[0.8rem] text-ink/70">Indicative start</dt>
              <dd class="text-[1.2rem] font-bold">{formatPriceLong(location.startingPrice)}</dd>
            </div>
          )
        }
        <div>
          <dt class="text-[0.8rem] text-ink/70">Zone</dt>
          <dd class="text-[1.2rem] font-bold">{location.zone} Hyderabad</dd>
        </div>
      </dl>
    </div>
  </section>

  <div class="shell band">
    <div class="grid gap-12 lg:grid-cols-[1fr_19rem] lg:gap-16">
      <div class="min-w-0">
        <section>
          <h2 class="text-display-3">About {location.name}</h2>
          <div class="measure mt-3 space-y-4 text-[1.02rem] leading-relaxed">
            {location.about.map((p) => <p>{p}</p>)}
          </div>
        </section>

        {
          location.priceRanges.length > 0 && (
            <section class="mt-12">
              <h2 class="text-display-3">Price ranges</h2>
              <p class="mt-2 text-[0.85rem] text-ink-subtle">
                Indicative ranges for the area, for orientation only — not a quotation for any
                specific property.
              </p>
              <ul class="ui mt-5 divide-y divide-line rounded-panel border border-line">
                {location.priceRanges.map((r) => (
                  <li class="flex flex-wrap items-baseline justify-between gap-3 p-4">
                    <span class="text-[0.98rem] font-semibold">{r.label}</span>
                    <span class="text-[1.05rem] font-bold">{r.range}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="mt-12">
          <h2 class="text-display-3">Popular configurations</h2>
          <ul class="ui mt-4 flex flex-wrap gap-1.5">
            {
              location.configurations.map((c) => (
                <li class="rounded-lg border border-line bg-surface px-3 py-1.5 text-[0.9rem] font-semibold">
                  {c}
                </li>
              ))
            }
          </ul>

          <h3 class="ui mt-7 text-[0.95rem] font-bold text-ink-muted">Property types here</h3>
          <ul class="ui mt-2.5 flex flex-wrap gap-1.5">
            {
              location.popularTypes.map((t) => (
                <li>
                  <a
                    href={url(`/properties?type=${t}&location=${location.slug}`)}
                    class="inline-block rounded-lg border border-line-strong px-3 py-1.5 text-[0.88rem] font-semibold transition-colors hover:border-beam hover:bg-surface"
                  >
                    {propertyTypeLabels[t]}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        {
          location.connectivity.length > 0 && (
            <section class="mt-12">
              <h2 class="text-display-3">Connectivity</h2>
              <ul class="ui mt-5 grid gap-px overflow-hidden rounded-panel border border-line bg-line sm:grid-cols-2">
                {location.connectivity.map((c) => (
                  <li class="bg-bg p-4">
                    <p class="flex items-center gap-1.5 text-[0.95rem] font-bold">
                      <Icon name="route" size={16} class="text-beam-ink" />
                      {c.label}
                    </p>
                    <p class="mt-1 text-[0.9rem] text-ink-muted">{c.detail}</p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="mt-12">
          <h2 class="text-display-3">Nearby areas</h2>
          <p class="measure mt-2.5 text-[0.98rem] leading-relaxed text-ink-muted">
            Worth looking at alongside {location.name} — often similar in character, sometimes
            noticeably different in price.
          </p>
          <ul class="ui mt-4 flex flex-wrap gap-1.5">
            {
              location.nearbyAreas.map((a) => (
                <li class="rounded-lg border border-line px-3 py-1.5 text-[0.88rem] font-medium text-ink-muted">
                  {a}
                </li>
              ))
            }
          </ul>
        </section>

        {location.faq.length > 0 && <section class="mt-12"><Faq items={location.faq} /></section>}
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-panel border border-line bg-surface p-5">
          <h2 class="text-[1.1rem]">Thinking about {location.name}?</h2>
          <p class="mt-2 text-[0.92rem] leading-relaxed text-ink-muted">
            Tell us your budget and what the household needs, and we will tell you whether this is the
            right area for it — including when the answer is no.
          </p>
          <div class="mt-5 space-y-2">
            <WhatsAppButton
              fullWidth
              label={`Ask about ${location.name}`}
              message={`Hi, I'm looking at property in ${location.name}, Hyderabad. Could you help me?`}
            />
            <a href={url(`/properties?location=${location.slug}`)} class="btn btn-outline w-full">
              See all {location.name} listings
            </a>
          </div>
        </div>

        {
          others.length > 0 && (
            <div class="mt-4 rounded-panel border border-line p-5">
              <h2 class="ui text-[0.9rem] font-bold text-ink-muted">
                Also in {location.zone} Hyderabad
              </h2>
              <ul class="mt-3 space-y-2">
                {others.map((o) => (
                  <li>
                    <a
                      href={url(`/locations/${o.slug}`)}
                      class="ui flex items-center justify-between gap-2 text-[0.92rem] font-semibold hover:text-beam-ink"
                    >
                      {o.name}
                      <Icon name="chevron-right" size={14} class="text-ink-subtle" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    {
      listings.length > 0 && (
        <section class="mt-14 border-t border-line pt-10">
          <SectionHead
            title={`Listings in ${location.name}`}
            linkHref={`/properties?location=${location.slug}`}
            linkLabel="Filter all listings"
          />
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {listings.map((p) => (
              <PropertyCard property={p} />
            ))}
          </div>
        </section>
      )
    }

    {
      projects.length > 0 && (
        <section class="mt-14 border-t border-line pt-10">
          <SectionHead title={`Projects in ${location.name}`} linkHref="/projects" linkLabel="All projects" />
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {projects.map((p) => (
              <ProjectCard project={p} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
