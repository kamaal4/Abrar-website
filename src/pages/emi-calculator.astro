---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EmiCalculator from '../components/EmiCalculator.astro';
import Icon from '../components/Icon.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Faq from '../components/Faq.astro';
import { url } from '../utils/url';

const notes = [
  {
    title: 'What this includes',
    copy: 'Principal and interest on a standard reducing-balance loan. That is the EMI your bank will quote.',
  },
  {
    title: 'What it does not include',
    copy: 'Processing fees, insurance premiums bundled into the loan, and the statutory costs of buying — stamp duty, transfer duty and registration, which together run to roughly 6% in Telangana.',
  },
  {
    title: 'The number that actually matters',
    copy: 'Total interest. Over twenty years it often approaches or exceeds the principal itself. Shortening the tenure by five years usually saves more than negotiating a quarter-point on the rate.',
  },
];

const faqLd = () => ({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

const faq = [
  {
    q: 'How much loan will I actually get?',
    a: 'Lenders typically fund up to 75–90% of the property value depending on the ticket size, and separately cap the EMI at a share of your net monthly income. The binding constraint is usually income, not property value.',
  },
  {
    q: 'Should I take a longer tenure for a lower EMI?',
    a: 'A longer tenure lowers the monthly outgo and raises the total interest substantially. It is a reasonable choice if it is the difference between buying and not buying — but treat it as a starting point and prepay when you can, rather than as a plan for twenty-five years.',
  },
  {
    q: 'Do plot loans work the same way?',
    a: 'The arithmetic is the same, but the terms are stricter: lower loan-to-value, shorter tenure, and usually a higher rate. If you intend to build, a composite construction loan is generally the better instrument.',
  },
  {
    q: 'Is a fixed or floating rate better?',
    a: 'Almost all Indian home loans are effectively floating, benchmarked to an external rate. Fixed offers are usually fixed for a short initial period only — read what happens after it.',
  },
];
---

<BaseLayout
  title="EMI calculator"
  description="Work out the monthly EMI, total interest and total payment on a home loan. Runs entirely in your browser — nothing is sent anywhere."
  jsonLd={faqLd()}
>
  <section class="border-b border-line bg-surface">
    <div class="shell py-8 sm:py-10">
      <Breadcrumbs items={[{ label: 'EMI Calculator' }]} />
      <h1 class="mt-3 text-display-2">EMI calculator</h1>
      <p class="measure mt-3 text-[1.02rem] leading-relaxed text-ink-muted">
        Change any of the three numbers and everything updates instantly. It runs in your browser —
        no account, no data leaving the page.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="shell">
      <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr] lg:gap-14">
        <div>
          <EmiCalculator principal={7_500_000} ratePct={8.5} years={20} heading="Work out your EMI" />

          <div class="mt-8">
            <h2 class="text-display-3">Reading the result honestly</h2>
            <div class="mt-5">
              {
                notes.map((n) => (
                  <div class="border-t border-line py-4">
                    <h3 class="ui text-[1.02rem] font-bold">{n.title}</h3>
                    <p class="measure mt-1.5 text-[0.95rem] leading-relaxed text-ink-muted">{n.copy}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
          <div class="rounded-panel border border-line bg-surface p-5">
            <h2 class="text-[1.1rem]">Not sure what you can borrow?</h2>
            <p class="mt-2 text-[0.92rem] leading-relaxed text-ink-muted">
              Send us your income and the kind of property you are looking at, and we will tell you the
              realistic range — including the total acquisition cost, not just the price.
            </p>
            <div class="mt-4">
              <WhatsAppButton
                fullWidth
                size="sm"
                label="Ask about loan eligibility"
                message="Hi, I'd like help working out what I can borrow for a property in Hyderabad."
              />
            </div>
          </div>

          <div class="rounded-panel border border-line p-5">
            <h2 class="ui text-[0.95rem] font-bold">Related</h2>
            <ul class="mt-3 space-y-2">
              {
                [
                  { label: 'Things to check before buying a flat', href: '/blog/things-to-check-before-buying-a-flat' },
                  { label: 'Ready-to-move vs under-construction', href: '/blog/ready-to-move-vs-under-construction' },
                  { label: '2 BHK vs 3 BHK', href: '/blog/2-bhk-vs-3-bhk-which-should-you-buy' },
                  { label: 'Browse properties', href: '/properties' },
                ].map((l) => (
                  <li>
                    <a
                      href={url(l.href)}
                      class="ui flex items-center justify-between gap-2 text-[0.92rem] font-semibold hover:text-gold-ink"
                    >
                      {l.label}
                      <Icon name="chevron-right" size={14} class="shrink-0 text-ink-subtle" />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </aside>
      </div>

      <div class="mt-14 border-t border-line pt-10">
        <Faq items={faq} title="Loan questions we get asked" />
      </div>
    </div>
  </section>
</BaseLayout>
