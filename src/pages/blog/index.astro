---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { getCollection } from 'astro:content';
import { asImageKey } from '../../data/images';
import { formatDate } from '../../utils/format';
import { url } from '../../utils/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const [lead, ...rest] = posts;
const categories = [...new Set(posts.map((p) => p.data.category))];
---

<BaseLayout
  title="Property guides and articles"
  description="Long-form answers to the questions buyers, sellers and investors actually ask about Hyderabad property."
>
  <section class="border-b border-line bg-surface">
    <div class="shell py-8 sm:py-10">
      <Breadcrumbs items={[{ label: 'Blog' }]} />
      <h1 class="mt-3 text-display-2">Reading before you buy</h1>
      <p class="measure mt-3 text-[1.02rem] leading-relaxed text-ink-muted">
        The questions people actually ask us, answered at the length they deserve. No listicles, no
        return projections.
      </p>
      <ul class="ui mt-5 flex flex-wrap gap-1.5">
        {
          categories.map((c) => (
            <li class="rounded-lg border border-line bg-bg px-3 py-1 text-[0.85rem] font-semibold text-ink-muted">
              {c}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="shell">
      {
        lead && (
          <a
            href={url(`/blog/${lead.id}`)}
            class="group grid gap-6 overflow-hidden rounded-panel border border-line transition-colors hover:border-line-strong lg:grid-cols-[1.2fr_1fr] lg:gap-0"
          >
            <span class="card-media block aspect-[16/9] lg:aspect-auto lg:h-full">
              <Img
                image={asImageKey(lead.data.heroImage)}
                widths={[640, 900, 1280]}
                sizes="(min-width: 1024px) 44rem, 92vw"
                loading="eager"
                class="h-full w-full object-cover"
              />
            </span>
            <span class="flex flex-col justify-center p-6 lg:p-8">
              <span class="ui text-[0.8rem] font-semibold text-clay-ink">{lead.data.category}</span>
              <span
                class="mt-2 text-[1.6rem] font-bold leading-tight tracking-[-0.03em] group-hover:text-clay-ink"
                style="font-family: var(--font-display)"
              >
                {lead.data.title}
              </span>
              <span class="mt-3 text-[1rem] leading-relaxed text-ink-muted">
                {lead.data.description}
              </span>
              <span class="ui mt-4 text-[0.85rem] text-ink-subtle">
                {formatDate(lead.data.date)} · {lead.data.readingTime} min read
              </span>
              <span class="link-arrow mt-4 text-[0.92rem]">
                Read the article
                <Icon name="arrow-right" size={15} />
              </span>
            </span>
          </a>
        )
      }

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          rest.map((post) => (
            <a href={url(`/blog/${post.id}`)} class="card group flex flex-col">
              <span class="card-media block aspect-[16/9]">
                <Img
                  image={asImageKey(post.data.heroImage)}
                  widths={[400, 640, 800]}
                  sizes="(min-width: 1024px) 24rem, 92vw"
                  class="h-full w-full object-cover"
                />
              </span>
              <span class="flex flex-1 flex-col p-4">
                <span class="ui text-[0.78rem] font-semibold text-clay-ink">{post.data.category}</span>
                <span
                  class="mt-1.5 text-[1.05rem] font-bold leading-snug group-hover:text-clay-ink"
                  style="font-family: var(--font-display)"
                >
                  {post.data.title}
                </span>
                <span class="mt-2 flex-1 text-[0.92rem] leading-relaxed text-ink-muted">
                  {post.data.description}
                </span>
                <span class="ui mt-3 text-[0.8rem] text-ink-subtle">
                  {formatDate(post.data.date)} · {post.data.readingTime} min read
                </span>
              </span>
            </a>
          ))
        }
      </div>

      <div class="mt-12 rounded-panel border border-line bg-surface p-6 sm:p-8">
        <h2 class="text-[1.3rem]">Have a question we have not written about?</h2>
        <p class="measure mt-2.5 text-[0.98rem] leading-relaxed text-ink-muted">
          Ask it directly. If it is a good question we will probably end up writing about it too.
        </p>
        <div class="mt-5">
          <WhatsAppButton label="Ask us anything" message="Hi, I have a question about buying property in Hyderabad:" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
