---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import Img from '../../components/Img.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import SectionHead from '../../components/SectionHead.astro';
import { asImageKey, getImage } from '../../data/images';
import { formatDate } from '../../utils/format';
import { siteConfig } from '../../config/site';
import { url } from '../../utils/url';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props as { post: Awaited<ReturnType<typeof getCollection<'blog'>>>[number] };
const { Content } = await render(post);

const all = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const related = all
  .filter((p) => p.id !== post.id)
  .sort(
    (a, b) =>
      (b.data.category === post.data.category ? 1 : 0) -
      (a.data.category === post.data.category ? 1 : 0),
  )
  .slice(0, 3);

const heroKey = asImageKey(post.data.heroImage);
const heroCredit = getImage(heroKey).credit;
const canonical = new URL(url(`/blog/${post.id}`), Astro.site ?? 'http://localhost:4321').href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  articleSection: post.data.category,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: siteConfig.name },
  author: { '@type': 'Organization', name: siteConfig.name },
};
---

<BaseLayout title={post.data.title} description={post.data.description} jsonLd={jsonLd}>
  <article>
    <header class="border-b border-line bg-surface">
      <div class="shell py-8 sm:py-10">
        <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }, { label: post.data.title }]} />
        <p class="ui mt-4 text-[0.85rem] font-semibold text-clay-ink">{post.data.category}</p>
        <h1 class="mt-2 max-w-3xl text-display-2">{post.data.title}</h1>
        <p class="measure mt-4 text-[1.05rem] leading-relaxed text-ink-muted">
          {post.data.description}
        </p>
        <p class="ui mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.85rem] text-ink-subtle">
          <span>{formatDate(post.data.date)}</span>
          <span class="text-ink-subtle" aria-hidden="true">·</span>
          <span class="flex items-center gap-1.5">
            <Icon name="clock" size={14} />
            {post.data.readingTime} min read
          </span>
        </p>
      </div>
    </header>

    <figure class="shell mt-8">
      <Img
        image={heroKey}
        widths={[640, 900, 1280]}
        sizes="(min-width: 1024px) 72rem, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[16/9] w-full rounded-panel object-cover"
      />
      <figcaption class="mt-2.5 text-[0.8rem] text-ink-subtle">
        {heroCredit.alt}
        {
          heroCredit.author && (
            <span>
              {' '}— {heroCredit.author}, {heroCredit.license},{' '}
              <a href={heroCredit.source} target="_blank" rel="noopener" class="underline underline-offset-2">
                {heroCredit.sourceName}
              </a>
            </span>
          )
        }
      </figcaption>
    </figure>

    <div class="shell py-10 lg:py-14">
      <div class="grid gap-12 lg:grid-cols-[1fr_16rem] lg:gap-16">
        <div class="prose-body min-w-0">
          <Content />
        </div>

        <aside class="lg:sticky lg:top-24 lg:self-start">
          <div class="rounded-panel border border-line bg-surface p-5">
            <h2 class="text-[1.05rem]">Want this applied to your situation?</h2>
            <p class="mt-2 text-[0.9rem] leading-relaxed text-ink-muted">
              Send us your budget and where you need to be. We will work through it with you rather
              than send a brochure.
            </p>
            <div class="mt-4">
              <WhatsAppButton
                fullWidth
                size="sm"
                label="Ask us about this"
                message={`Hi, I read your article "${post.data.title}" and I'd like to ask about my own situation.`}
              />
            </div>
          </div>
        </aside>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="band-tight border-t border-line bg-surface">
        <div class="shell">
          <SectionHead title="Related reading" linkHref="/blog" linkLabel="All articles" />
          <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <a href={url(`/blog/${p.id}`)} class="card group flex flex-col">
                <span class="card-media block aspect-[16/9]">
                  <Img
                    image={asImageKey(p.data.heroImage)}
                    widths={[400, 640]}
                    sizes="(min-width: 1024px) 24rem, 92vw"
                    class="h-full w-full object-cover"
                  />
                </span>
                <span class="flex flex-1 flex-col p-4">
                  <span class="ui text-[0.78rem] font-semibold text-clay-ink">{p.data.category}</span>
                  <span
                    class="mt-1.5 text-[1rem] font-bold leading-snug group-hover:text-clay-ink"
                    style="font-family: var(--font-display)"
                  >
                    {p.data.title}
                  </span>
                  <span class="ui mt-2 text-[0.8rem] text-ink-subtle">
                    {p.data.readingTime} min read
                  </span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
